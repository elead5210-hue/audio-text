# Audio-to-text service configuration (read at runtime).
# Every variable has a safe default in app/config.py; the values below match those defaults.
# PORT, APP_PORT, SERVER_PORT, HTTP_PORT and WEB_PORT are intentionally not used.

# Network binding (the container listens on 0.0.0.0:8000)
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8000

# Whisper model settings (CPU-only, int8 quantization)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=1

# Writable directories (kept outside the application directory)
WHISPER_MODEL_CACHE_DIR=/tmp/whisper-models
UPLOAD_TEMP_DIR=/tmp/uploads

# Upload validation
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=.ogg
ALLOWED_CONTENT_TYPES=audio/ogg,application/ogg,audio/x-ogg,audio/opus,video/ogg

# Logging
LOG_LEVEL=INFO